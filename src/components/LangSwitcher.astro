---
import { getUI, otherLocale, type Locale } from "../i18n";

export interface Props {
  locale: Locale;
  // path hiện tại không chứa locale prefix, ví dụ: "/" hoặc "/tos" hoặc "/about"
  currentPath: string;
}
const { locale, currentPath } = Astro.props;
const t = getUI(locale);
const target = otherLocale(locale);
const normalized = currentPath === "/" ? "" : currentPath;
const href = `/${target}${normalized}`;
---

<a
  class="lang-switch"
  href={href}
  data-lang={target}
  aria-label={`Switch to ${t.lang.switchTo}`}
  data-tooltip={`Switch to ${t.lang.switchTo}`}
>
  <span class="lang-current">{locale.toUpperCase()}</span>
  <span class="lang-sep">/</span>
  <span class="lang-other">{target.toUpperCase()}</span>
</a>

<script is:inline>
  // Lưu lựa chọn ngôn ngữ của khách để root `/` biết redirect về đâu lần sau.
  document.querySelectorAll(".lang-switch").forEach(function (el) {
    el.addEventListener("click", function (e) {
      const lang = el.getAttribute("data-lang");
      if (lang) {
        try {
          localStorage.setItem("mirra.lang", lang);
        } catch (_e) {}
      }
    });
  });
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 10px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .lang-switch:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }
  .lang-current {
    color: var(--color-text);
  }
  .lang-sep {
    color: var(--color-text-subtle);
  }
  .lang-other {
    color: var(--color-text-subtle);
  }
  .lang-switch:hover .lang-other {
    color: var(--color-accent);
  }
</style>
