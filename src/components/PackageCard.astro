---
import Icon from "./Icon.astro";
import { getUI, formatPrice, type Locale } from "../i18n";
import packages from "../../content/packages.json";

export interface Props {
  locale: Locale;
  packageId: "A" | "B" | "C";
  highlight?: boolean;
}
const { locale, packageId, highlight = false } = Astro.props;
const t = getUI(locale);
const pkg = packages.packages.find((p) => p.id === packageId)!;
const examples = packages.modelComplexityExamples;
---

<article class:list={["pkg-card", { highlight }]}>
  <header class="pkg-head">
    <span class="pkg-badge">{pkg.id}</span>
    <div>
      <h3 class="pkg-name">{pkg.name[locale]}</h3>
      <p class="pkg-tagline">{pkg.tagline[locale]}</p>
    </div>
  </header>

  <div class="pkg-prices">
    <div class="price-row">
      <span class="price-label">{t.home.packageCardBasic}</span>
      <span class="price-value">{formatPrice(pkg.basic, locale)}</span>
      <a
        class="price-example"
        href={examples.basic}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.home.packageCardSeeExample} <Icon name="arrow-up-right" size={12} />
      </a>
    </div>
    <div class="price-row">
      <span class="price-label">{t.home.packageCardDetail}</span>
      <span class="price-value">{formatPrice(pkg.detail, locale)}</span>
      <a
        class="price-example"
        href={examples.detail}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.home.packageCardSeeExample} <Icon name="arrow-up-right" size={12} />
      </a>
    </div>
  </div>

  <div class="pkg-features">
    <p class="features-title">{t.home.packageCardIncludes}</p>
    <ul>
      {
        pkg.features[locale].map((f) => (
          <li>
            <Icon name="check" size={14} class="check" />
            <span>{f}</span>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .pkg-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--color-shadow);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .pkg-card:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }
  .pkg-card.highlight {
    border-color: var(--color-accent);
    position: relative;
  }
  .pkg-card.highlight::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: var(--radius-lg);
    padding: 1px;
    background: linear-gradient(
      135deg,
      var(--color-accent) 0%,
      color-mix(in oklab, var(--color-accent) 30%, transparent) 100%
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .pkg-head {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .pkg-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
    font-weight: 700;
    font-size: 16px;
    flex-shrink: 0;
  }
  .pkg-name {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 2px 0;
    color: var(--color-text);
  }
  .pkg-tagline {
    margin: 0;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .pkg-prices {
    display: grid;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
  }
  .price-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "label value"
      "example example";
    row-gap: 2px;
    align-items: baseline;
  }
  .price-label {
    grid-area: label;
    font-size: 13px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .price-value {
    grid-area: value;
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .price-example {
    grid-area: example;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 11px;
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: color 0.15s;
  }
  .price-example:hover {
    color: var(--color-accent);
  }

  .pkg-features {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .features-title {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .pkg-features ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .pkg-features li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  :global(.check) {
    color: var(--color-success);
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
