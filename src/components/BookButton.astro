---
import Icon from "./Icon.astro";
import { getUI, type Locale } from "../i18n";
import config from "../../content/config.json";

export interface Props {
  locale: Locale;
  size?: "sm" | "md" | "lg";
  variant?: "primary" | "ghost";
}
const { locale, size = "md", variant = "primary" } = Astro.props;
const t = getUI(locale);

// Mỗi loại commission có form Google riêng (vi/en theo locale của trang).
// Nếu URL là placeholder [TODO: ...] → disable item (user chưa cung cấp).
function resolveUrl(url: string): { href: string; disabled: boolean } {
  const disabled = !url || url.startsWith("[TODO");
  return { href: disabled ? "#" : url, disabled };
}

const vtuber = resolveUrl(config.bookingUrl.vtuber[locale]);
const game = resolveUrl(config.bookingUrl.game[locale]);

// Dropdown items: 2 loại commission. Mỗi item mở form theo locale hiện tại.
const dropdownItems = [
  { ...vtuber, label: t.bookForms.vtuber },
  { ...game, label: t.bookForms.game },
];
---

<div class="book-wrapper" data-book>
  {/* Button chính: click để toggle dropdown (không link trực tiếp —
      user cần chủ động chọn loại commission). */}
  <button
    type="button"
    class={`book-btn book-${size} book-${variant}`}
    aria-label={t.nav.book}
    aria-haspopup="menu"
    aria-expanded="false"
    data-book-toggle
  >
    <span>{t.nav.book}</span>
    <Icon name="chevron-down" size={size === "sm" ? 14 : 16} />
  </button>

  <div class="book-dropdown" role="menu" data-book-menu>
    {dropdownItems.map((item) => (
      <a
        class:list={["book-dropdown-item", { disabled: item.disabled }]}
        href={item.href}
        target={item.disabled ? undefined : "_blank"}
        rel={item.disabled ? undefined : "noopener noreferrer"}
        role="menuitem"
        aria-disabled={item.disabled ? "true" : undefined}
        tabindex={item.disabled ? -1 : undefined}
      >
        <span class="book-dropdown-label">{item.label}</span>
        {item.disabled ? (
          <span class="book-dropdown-badge">{t.bookForms.comingSoon}</span>
        ) : (
          <Icon name="arrow-up-right" size={12} />
        )}
      </a>
    ))}
  </div>
</div>

<script is:inline>
  // Click-based dropdown toggle: hoạt động trên cả mobile (hover) và desktop.
  // Hover trên desktop vẫn open qua CSS. Click outside để close.
  (function () {
    const wrappers = document.querySelectorAll("[data-book]");
    wrappers.forEach(function (wrapper) {
      const btn = wrapper.querySelector("[data-book-toggle]");
      const menu = wrapper.querySelector("[data-book-menu]");
      if (!btn || !menu) return;

      function close() {
        wrapper.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
      }
      function open() {
        wrapper.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
      }

      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        if (wrapper.classList.contains("open")) {
          close();
        } else {
          // Đóng dropdown khác trước khi mở
          document.querySelectorAll("[data-book].open").forEach(function (w) {
            if (w !== wrapper) {
              w.classList.remove("open");
              const b = w.querySelector("[data-book-toggle]");
              if (b) b.setAttribute("aria-expanded", "false");
            }
          });
          open();
        }
      });

      // Click vào item → đóng dropdown (trừ item disabled)
      menu.querySelectorAll(".book-dropdown-item").forEach(function (item) {
        item.addEventListener("click", function (e) {
          if (item.classList.contains("disabled")) {
            e.preventDefault();
            return;
          }
          close();
        });
      });
    });

    // Click ngoài → đóng tất cả
    document.addEventListener("click", function (e) {
      document.querySelectorAll("[data-book].open").forEach(function (w) {
        if (!w.contains(e.target)) {
          w.classList.remove("open");
          const b = w.querySelector("[data-book-toggle]");
          if (b) b.setAttribute("aria-expanded", "false");
        }
      });
    });

    // ESC → đóng
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        document.querySelectorAll("[data-book].open").forEach(function (w) {
          w.classList.remove("open");
          const b = w.querySelector("[data-book-toggle]");
          if (b) b.setAttribute("aria-expanded", "false");
        });
      }
    });
  })();
</script>

<style>
  .book-wrapper {
    position: relative;
    display: inline-block;
  }

  .book-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
    white-space: nowrap;
  }
  .book-primary {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .book-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }
  .book-ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .book-ghost:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border-strong);
  }
  .book-sm {
    padding: 7px 12px;
    font-size: 13px;
  }
  .book-md {
    padding: 10px 16px;
    font-size: 14px;
  }
  .book-lg {
    padding: 14px 22px;
    font-size: 16px;
  }

  /* ===== DROPDOWN =====
     Open qua class .open (click-based). Trên desktop pointer, hover
     cũng mở (fallback cho muscle memory). ::before là cầu nối chuột. */
  .book-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 220px;
    padding: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--color-shadow);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    z-index: 20;
  }
  .book-dropdown::before {
    content: "";
    position: absolute;
    top: -6px;
    left: 0;
    right: 0;
    height: 6px;
  }

  .book-wrapper.open .book-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (hover: hover) {
    .book-wrapper:hover .book-dropdown,
    .book-wrapper:focus-within .book-dropdown {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  .book-dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .book-dropdown-item:hover,
  .book-dropdown-item:focus-visible {
    background: var(--color-surface-2);
    color: var(--color-text);
  }
  .book-dropdown-item.disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .book-dropdown-item.disabled:hover {
    background: transparent;
    color: var(--color-text-muted);
  }
  .book-dropdown-label {
    flex: 1;
  }
  .book-dropdown-badge {
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 6px;
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-text-subtle);
    border: 1px solid var(--color-border);
  }
</style>
