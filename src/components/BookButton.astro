---
import Icon from "./Icon.astro";
import { getUI, type Locale } from "../i18n";
import config from "../../content/config.json";

export interface Props {
  locale: Locale;
  size?: "sm" | "md" | "lg";
  variant?: "primary" | "ghost";
}
const { locale, size = "md", variant = "primary" } = Astro.props;
const t = getUI(locale);
const href = config.bookingUrl[locale];
// Nếu link EN chưa có (placeholder), vẫn render nhưng dán link VI để không chết — khách có thể hiểu.
const safeHref = href && !href.startsWith("[TODO") ? href : config.bookingUrl.vi;

// Dropdown items: luôn 2 lựa chọn VI/EN. Dùng URL trực tiếp (không fallback)
// vì user chủ động chọn — nếu link lỗi để user biết chứ không ngấm ngầm redirect.
const dropdownItems = [
  { url: config.bookingUrl.vi, label: t.bookForms.vi },
  { url: config.bookingUrl.en, label: t.bookForms.en },
];
---

<div class="book-wrapper">
  <a
    class={`book-btn book-${size} book-${variant}`}
    href={safeHref}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.nav.book}
    aria-haspopup="menu"
  >
    <span>{t.nav.book}</span>
    <Icon name="arrow-up-right" size={size === "sm" ? 14 : 16} />
  </a>

  {/* Dropdown: hiện khi hover wrapper hoặc focus-within (keyboard-friendly). */}
  <div class="book-dropdown" role="menu">
    {dropdownItems.map((item) => (
      <a
        class="book-dropdown-item"
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        role="menuitem"
      >
        {item.label}
        <Icon name="arrow-up-right" size={12} />
      </a>
    ))}
  </div>
</div>

<style>
  /* Wrapper giữ dropdown absolute positioned bên dưới button. */
  .book-wrapper {
    position: relative;
    display: inline-block;
  }

  .book-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
    white-space: nowrap;
  }
  .book-primary {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .book-primary:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  }
  .book-ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .book-ghost:hover {
    background: var(--color-surface-2);
    border-color: var(--color-border-strong);
  }
  .book-sm {
    padding: 7px 12px;
    font-size: 13px;
  }
  .book-md {
    padding: 10px 16px;
    font-size: 14px;
  }
  .book-lg {
    padding: 14px 22px;
    font-size: 16px;
  }

  /* ===== DROPDOWN =====
     Hiện khi hover wrapper hoặc focus vào bất kỳ element con nào (keyboard).
     Pseudo ::before tạo "cầu nối" vô hình 6px giữa button và menu để chuột
     di chuyển qua gap mà không trigger mouseleave → đóng menu. */
  .book-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 100%;
    padding: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--color-shadow);
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    z-index: 20;
    white-space: nowrap;
  }
  .book-dropdown::before {
    content: "";
    position: absolute;
    top: -6px;
    left: 0;
    right: 0;
    height: 6px;
  }

  .book-wrapper:hover .book-dropdown,
  .book-wrapper:focus-within .book-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .book-dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .book-dropdown-item:hover,
  .book-dropdown-item:focus-visible {
    background: var(--color-surface-2);
    color: var(--color-text);
  }

  /* Mobile: không có hover thực sự → ẩn dropdown.
     Tap vào main button vẫn dẫn tới form mặc định theo locale. */
  @media (hover: none) {
    .book-dropdown {
      display: none;
    }
  }
</style>
