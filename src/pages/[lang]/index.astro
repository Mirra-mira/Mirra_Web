---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import BookButton from "../../components/BookButton.astro";
import PriceTable from "../../components/PriceTable.astro";
import PackageCard from "../../components/PackageCard.astro";
import OutfitTable from "../../components/OutfitTable.astro";
import GameModelTable from "../../components/GameModelTable.astro";
import TOC from "../../components/TOC.astro";
import { getUI, formatPrice, LOCALES, type Locale } from "../../i18n";
import packages from "../../../content/packages.json";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getUI(lang);

const blendshape = packages.surcharges.find((s) => s.id === "extra_blendshape")!;
const missingRef = packages.surcharges.find((s) => s.id === "missing_reference")!;
const arkit = packages.surcharges.find((s) => s.id === "arkit")!;

const gameModel = packages.gameModel;

// TOC items theo tab active (giống pattern bên tos.astro):
//   • Tab VTuber: Phần I + Outfit (II) + Animation (III) — II và III nằm ngoài
//     tab, dùng chung cho cả 2 tab (hiển thị dưới panel).
//   • Tab Game: tách nhỏ các sub-section của Phần IV cho dễ nhảy, kèm II + III
//     vì chúng ở cuối trang và vẫn thấy khi scroll xuống.
const vtuberTocItems = [
  { id: "packages", label: t.home.sectionPackagesTitle },
  { id: "outfits", label: t.home.sectionOutfitsTitle },
  { id: "animations", label: t.home.sectionAnimationsTitle },
];
const gameTocItems = [
  { id: "game-scope", label: t.home.sectionGameIncludesTitle },
  { id: "game-pricing", label: t.home.sectionGamePricingTitle },
  { id: "game-surcharges", label: t.home.sectionGameSurchargesTitle },
  { id: "game-process", label: t.home.sectionGameProcessTitle },
  { id: "game-terms", label: t.home.sectionGameTermsTitle },
  { id: "game-questions", label: t.home.sectionGameQuestionsTitle },
  { id: "outfits", label: t.home.sectionOutfitsTitle },
  { id: "animations", label: t.home.sectionAnimationsTitle },
];
---

<BaseLayout locale={lang} currentPath="/">
  {/* 2 bộ TOC render cùng DOM, ẩn bộ không active theo data-tab + script.
      Pattern giống /tos để nhất quán. */}
  <div id="toc-vtuber" class="toc-slot" data-tab="vtuber">
    <TOC items={vtuberTocItems} locale={lang} />
  </div>
  <div id="toc-game" class="toc-slot toc-slot-hidden" data-tab="game">
    <TOC items={gameTocItems} locale={lang} />
  </div>
  {/* ===== HERO ===== */}
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-tag">
        <span>{t.home.heroTag}</span>
      </div>
      <h1 class="hero-title">{t.home.heroTitle}</h1>
      <p class="hero-subtitle">{t.home.heroSubtitle}</p>
      <div class="hero-ctas">
        <BookButton locale={lang} size="lg" variant="primary" />
        <a class="link-ghost" href={`/${lang}/tos`}>
          {t.home.heroCtaSecondary} <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  {/* ===== TAB BAR =====
       2 tab chia nhánh dịch vụ: VTuber (Phần I) vs Model Game (Phần IV).
       Phần II (Outfit) + Phần III (Animation) nằm ngoài 2 tab, dùng chung,
       render ở cuối trang. */}
  <div class="home-tabs-wrap">
    <div class="home-tabs" role="tablist" aria-label={t.home.heroTag}>
      <button
        type="button"
        class="home-tab active"
        role="tab"
        aria-selected="true"
        data-tab-btn="vtuber"
        id="home-tab-btn-vtuber"
        aria-controls="home-tab-panel-vtuber"
      >
        {t.home.tabVtuber}
      </button>
      <button
        type="button"
        class="home-tab"
        role="tab"
        aria-selected="false"
        data-tab-btn="game"
        id="home-tab-btn-game"
        aria-controls="home-tab-panel-game"
      >
        {t.home.tabGame}
      </button>
    </div>
  </div>

  {/* ===== PANEL VTUBER (Phần I) ===== */}
  <div
    class="home-tab-panel"
    role="tabpanel"
    id="home-tab-panel-vtuber"
    data-tab-panel="vtuber"
    aria-labelledby="home-tab-btn-vtuber"
  >
    {/* Nút đọc TOS tương ứng, ngay đầu panel */}
    <div class="tab-tos-link-wrap">
      <a class="link-ghost" href={`/${lang}/tos#vtuber`}>
        {t.home.readTosOfTab}
      </a>
    </div>

  {/* ===== PART I: PACKAGES ===== */}
  <section class="section" id="packages">
    <div class="section-inner">
      <div class="section-head">
        <h2 class="section-title">{t.home.sectionPackagesTitle}</h2>
        <p class="section-intro">{t.home.sectionPackagesIntro}</p>
      </div>

      <PriceTable locale={lang} />

      <div class="pkg-grid">
        <PackageCard locale={lang} packageId="A" />
        <PackageCard locale={lang} packageId="B" />
        <PackageCard locale={lang} packageId="C" highlight={true} />
      </div>

      {/* Why */}
      <div class="why-card">
        <h3 class="why-title">{t.home.sectionWhyTitle}</h3>
        <p class="why-body">{t.home.sectionWhyBody}</p>
      </div>

      {/* Surcharges */}
      <div class="surcharges">
        <h3 class="surcharges-title">{t.home.sectionSurchargesTitle}</h3>
        <div class="surcharges-grid">
          <div class="surcharge-card">
            <p class="surcharge-label">{blendshape.label[lang]}</p>
            <p class="surcharge-price">
              {formatPrice(blendshape.price, lang)}
              <span class="surcharge-unit">{blendshape.unit[lang]}</span>
            </p>
          </div>
          <div class="surcharge-card">
            <p class="surcharge-label">{missingRef.label[lang]}</p>
            <p class="surcharge-price">
              {missingRef.price.percentOfPackage}%
              <span class="surcharge-unit">{t.home.sectionSurchargesPercentOf}</span>
            </p>
            <p class="surcharge-note">{missingRef.note[lang]}</p>
          </div>
          <div class="surcharge-card">
            <p class="surcharge-label">{arkit.label[lang]}</p>
            <p class="surcharge-price">
              {formatPrice(arkit.price.basic, lang)}
              <span class="surcharge-unit">· {t.home.packageCardBasic}</span>
            </p>
            <p class="surcharge-price">
              {formatPrice(arkit.price.detail, lang)}
              <span class="surcharge-unit">· {t.home.packageCardDetail}</span>
            </p>
            <p class="surcharge-note">{arkit.note[lang]}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  </div> {/* ===== END PANEL VTUBER ===== */}

  {/* ===== PANEL GAME (Phần IV) =====
       Ẩn mặc định. Script tab bên dưới sẽ toggle `hidden` + class khi switch. */}
  <div
    class="home-tab-panel home-tab-panel-hidden"
    role="tabpanel"
    id="home-tab-panel-game"
    data-tab-panel="game"
    aria-labelledby="home-tab-btn-game"
    hidden
  >
    <div class="tab-tos-link-wrap">
      <a class="link-ghost" href={`/${lang}/tos#game`}>
        {t.home.readTosOfTab}
      </a>
    </div>

    {/* ===== PART IV: GAME MODEL =====
         Dùng .section (default bg) thay cho section-alt cũ để nhịp xen kẽ với
         Phần II (section-alt) nằm ngay dưới panel Game vẫn đẹp cho cả 2 tab. */}
    <section class="section" id="game-model">
      <div class="section-inner">
        <div class="section-head">
          <h2 class="section-title">{t.home.sectionGameTitle}</h2>
          <p class="section-intro">{gameModel.intro[lang]}</p>
        </div>

        {/* Bao gồm / Không bao gồm — 2 card side-by-side trên desktop */}
        <div class="game-scope" id="game-scope">
          <div class="game-scope-card game-scope-includes">
            <h3 class="game-scope-title">{t.home.sectionGameIncludesTitle}</h3>
            <ul>
              {gameModel.includes[lang].map((item) => (
                <li>
                  <Icon name="check" size={14} class="check" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="game-scope-card game-scope-excludes">
            <h3 class="game-scope-title">{t.home.sectionGameExcludesTitle}</h3>
            <ul>
              {gameModel.excludes[lang].map((item) => (
                <li>
                  <span class="dash" aria-hidden="true">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {/* Bảng giá 3 × 2 — wrap div để có anchor id cho TOC jump */}
        <div id="game-pricing">
          <GameModelTable locale={lang} />
        </div>

        {/* Phụ phí & ưu đãi */}
        <div class="game-surcharges" id="game-surcharges">
          <h3 class="game-block-title">{t.home.sectionGameSurchargesTitle}</h3>
          <div class="game-surcharges-grid">
            {gameModel.surcharges.map((s) => (
              <div class="game-surcharge-card">
                <p class="game-surcharge-label">{s.label[lang]}</p>
                <p class="game-surcharge-value">{s.value[lang]}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Quy trình — ordered list đánh số, nhẹ nhàng */}
        <div class="game-process" id="game-process">
          <h3 class="game-block-title">{t.home.sectionGameProcessTitle}</h3>
          <ol class="game-process-list">
            {gameModel.process[lang].map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>

        {/* Điều khoản — dạng list bullet dashed box, đồng nhất với
            .outfit-conditions / .anim-conditions */}
        <div class="game-terms" id="game-terms">
          <h3 class="game-terms-title">{t.home.sectionGameTermsTitle}</h3>
          <ul>
            {gameModel.terms[lang].map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>

        {/* Câu hỏi khi đặt hàng — list đánh số, để khách chuẩn bị trước khi mở form */}
        <div class="game-questions" id="game-questions">
          <h3 class="game-block-title">{t.home.sectionGameQuestionsTitle}</h3>
          <p class="game-questions-intro">{t.home.sectionGameQuestionsIntro}</p>
          <ol class="game-questions-list">
            {gameModel.questions[lang].map((q) => (
              <li>{q}</li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  </div> {/* ===== END PANEL GAME ===== */}

  {/* ===== PART II: EXTRA OUTFITS =====
       Ngoài tab: Outfit là add-on dùng chung, hiển thị cho cả 2 tab. */}
  <section class="section section-alt" id="outfits">
    <div class="section-inner">
      <div class="section-head">
        <h2 class="section-title">{t.home.sectionOutfitsTitle}</h2>
      </div>
      <OutfitTable locale={lang} />
    </div>
  </section>

  {/* ===== PART III: ANIMATIONS =====
       Ngoài tab, dùng chung. Đổi sang .section (default bg) để nhịp xen kẽ. */}
  <section class="section" id="animations">
    <div class="section-inner">
      <div class="section-head">
        <h2 class="section-title">{t.home.sectionAnimationsTitle}</h2>
      </div>

      {/* Grid 4 card: idle, sit, walk, run — reuse style surcharge-* để đồng bộ */}
      <div class="surcharges-grid">
        {packages.animations.items.map((a) => (
          <div class="surcharge-card">
            <p class="surcharge-label">{a.label[lang]}</p>
            <p class="surcharge-price">
              {formatPrice(a.price, lang)}
              {a.note && <span class="surcharge-unit">· {a.note[lang]}</span>}
            </p>
          </div>
        ))}
      </div>

      {/* Điều kiện — reuse style conditions giống OutfitTable (list bullet) */}
      <div class="anim-conditions">
        <h3 class="anim-conditions-title">{t.home.sectionAnimationsConditionsTitle}</h3>
        <ul class="anim-conditions-list">
          {packages.animations.conditions[lang].map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ===== CTA BOOK ===== */}
  <section class="cta-section">
    <div class="cta-inner">
      <h2 class="cta-title">{t.home.ctaBookTitle}</h2>
      <p class="cta-body">{t.home.ctaBookBody}</p>
      <div class="cta-actions">
        <BookButton locale={lang} size="lg" variant="primary" />
        <a class="link-ghost" href={`/${lang}/tos`}>{t.home.ctaReadTos}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    // Tab switcher cho trang chủ. Pattern tương tự /tos nhưng storage key riêng
    // (`mirra.home.tab`) để tab home và tab tos độc lập nhau. Hash URL dùng
    // chung `#vtuber`/`#game` — khớp với anchor trên /tos, nên khi user bấm
    // "Đọc TOS" từ tab Game trên home sẽ sang /tos#game và tab game ở đó auto
    // mở (tos.astro cũng đọc hash).
    const STORAGE_KEY = "mirra.home.tab";
    const tabs = document.querySelectorAll(".home-tabs [data-tab-btn]");
    const panels = document.querySelectorAll(".home-tab-panel[data-tab-panel]");
    const tocSlots = document.querySelectorAll(".toc-slot");

    function setTab(name) {
      tabs.forEach(function (btn) {
        const active = btn.getAttribute("data-tab-btn") === name;
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-selected", active ? "true" : "false");
      });
      panels.forEach(function (p) {
        const active = p.getAttribute("data-tab-panel") === name;
        p.classList.toggle("home-tab-panel-hidden", !active);
        if (active) {
          p.removeAttribute("hidden");
        } else {
          p.setAttribute("hidden", "");
        }
      });
      tocSlots.forEach(function (slot) {
        const active = slot.getAttribute("data-tab") === name;
        slot.classList.toggle("toc-slot-hidden", !active);
      });
      try {
        sessionStorage.setItem(STORAGE_KEY, name);
      } catch (_e) {}
    }

    // Khôi phục từ sessionStorage hoặc URL hash (#game / #vtuber)
    let initial = "vtuber";
    try {
      const saved = sessionStorage.getItem(STORAGE_KEY);
      if (saved === "game" || saved === "vtuber") initial = saved;
    } catch (_e) {}
    if (window.location.hash === "#game") initial = "game";
    if (window.location.hash === "#vtuber") initial = "vtuber";
    setTab(initial);

    tabs.forEach(function (btn) {
      btn.addEventListener("click", function () {
        setTab(btn.getAttribute("data-tab-btn"));
      });
    });
  })();
</script>

<style>
  /* ===== TAB BAR =====
     Visual style khớp với .tos-tabs ở /tos để UX nhất quán. Tab bar đứng độc
     lập (căn giữa) ngay sau hero. */
  .home-tabs-wrap {
    padding: 0 20px;
    display: flex;
    justify-content: center;
  }
  .home-tabs {
    display: flex;
    gap: 4px;
    padding: 4px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .home-tab {
    padding: 8px 18px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .home-tab:hover {
    color: var(--color-text);
  }
  .home-tab.active {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--color-shadow);
  }

  /* ===== PANEL VISIBILITY ===== */
  .home-tab-panel-hidden {
    display: none;
  }

  /* ===== TOS LINK trong mỗi panel =====
     Nhỏ gọn, căn giữa, nằm giữa tab bar và section đầu tiên của panel. Không
     chiếm quá nhiều space để không át nội dung chính. */
  .tab-tos-link-wrap {
    padding: 20px 20px 0;
    display: flex;
    justify-content: center;
  }

  /* ===== TOC SLOTS =====
     2 bộ TOC render cùng DOM, ẩn bộ không active. Giống pattern /tos. */
  .toc-slot-hidden :global(.toc) {
    display: none !important;
  }

  /* ===== HERO ===== */
  .hero {
    padding: 60px 20px 40px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 1200px;
    height: 1200px;
    max-width: 150vw;
    background: radial-gradient(
      circle at center,
      color-mix(in oklab, var(--color-accent) 10%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(28px, 6vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    max-width: 20ch;
  }
  .hero-subtitle {
    margin: 0;
    font-size: clamp(15px, 2.5vw, 17px);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 55ch;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
  }

  /* ===== SECTIONS ===== */
  .section {
    padding: 60px 20px;
  }
  .section-alt {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 60ch;
  }
  .section-title {
    margin: 0;
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }
  .section-intro {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ===== PACKAGES GRID ===== */
  .pkg-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .pkg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .pkg-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ===== WHY ===== */
  .why-card {
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }
  .why-title {
    margin: 0 0 8px 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
  }
  .why-body {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 70ch;
  }

  /* ===== SURCHARGES ===== */
  .surcharges-title {
    margin: 0 0 12px 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    color: var(--color-text-subtle);
  }
  .surcharges-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .surcharges-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Từ 1024px: 3 cột để chứa đủ blendshape / missing-ref / arkit một hàng */
  @media (min-width: 1024px) {
    .surcharges-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  .surcharge-card {
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .surcharge-label {
    margin: 0 0 8px 0;
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .surcharge-price {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: var(--color-warning);
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }
  .surcharge-unit {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-subtle);
    text-transform: lowercase;
  }
  .surcharge-note {
    margin: 10px 0 0 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-subtle);
  }

  /* ===== PART III: ANIMATIONS CONDITIONS =====
     Style mô phỏng .outfit-conditions trong OutfitTable để nhìn đồng bộ. */
  .anim-conditions {
    margin-top: 24px;
    padding: 20px;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1px dashed var(--color-border-strong);
  }
  .anim-conditions-title {
    margin: 0 0 10px 0;
    font-size: 12px;
    font-weight: 600;
