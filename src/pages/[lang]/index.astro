---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import BookButton from "../../components/BookButton.astro";
import PriceTable from "../../components/PriceTable.astro";
import PackageCard from "../../components/PackageCard.astro";
import OutfitTable from "../../components/OutfitTable.astro";
import TOC from "../../components/TOC.astro";
import { getUI, formatPrice, LOCALES, type Locale } from "../../i18n";
import packages from "../../../content/packages.json";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = getUI(lang);

const blendshape = packages.surcharges.find((s) => s.id === "extra_blendshape")!;
const missingRef = packages.surcharges.find((s) => s.id === "missing_reference")!;

// TOC items cho trang chủ: 3 section Phần I/II/III
const tocItems = [
  {
    id: "packages",
    label: `${t.home.sectionPackagesTag} · ${t.home.sectionPackagesTitle}`,
  },
  {
    id: "outfits",
    label: `${t.home.sectionOutfitsTag} · ${t.home.sectionOutfitsTitle}`,
  },
  {
    id: "animations",
    label: `${t.home.sectionAnimationsTag} · ${t.home.sectionAnimationsTitle}`,
  },
];
---

<BaseLayout locale={lang} currentPath="/">
  <TOC items={tocItems} locale={lang} />
  {/* ===== HERO ===== */}
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-tag">
        <span>{t.home.heroTag}</span>
      </div>
      <h1 class="hero-title">{t.home.heroTitle}</h1>
      <p class="hero-subtitle">{t.home.heroSubtitle}</p>
      <div class="hero-ctas">
        <BookButton locale={lang} size="lg" variant="primary" />
        <a class="link-ghost" href={`/${lang}/tos`}>
          {t.home.heroCtaSecondary} <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  {/* ===== PART I: PACKAGES ===== */}
  <section class="section" id="packages">
    <div class="section-inner">
      <div class="section-head">
        <span class="section-tag">{t.home.sectionPackagesTag}</span>
        <h2 class="section-title">{t.home.sectionPackagesTitle}</h2>
        <p class="section-intro">{t.home.sectionPackagesIntro}</p>
      </div>

      <PriceTable locale={lang} />

      <div class="pkg-grid">
        <PackageCard locale={lang} packageId="A" />
        <PackageCard locale={lang} packageId="B" />
        <PackageCard locale={lang} packageId="C" highlight={true} />
      </div>

      {/* Why */}
      <div class="why-card">
        <h3 class="why-title">{t.home.sectionWhyTitle}</h3>
        <p class="why-body">{t.home.sectionWhyBody}</p>
      </div>

      {/* Surcharges */}
      <div class="surcharges">
        <h3 class="surcharges-title">{t.home.sectionSurchargesTitle}</h3>
        <div class="surcharges-grid">
          <div class="surcharge-card">
            <p class="surcharge-label">{blendshape.label[lang]}</p>
            <p class="surcharge-price">
              {formatPrice(blendshape.price, lang)}
              <span class="surcharge-unit">{blendshape.unit[lang]}</span>
            </p>
          </div>
          <div class="surcharge-card">
            <p class="surcharge-label">{missingRef.label[lang]}</p>
            <p class="surcharge-price">
              {missingRef.price.percentOfPackage}%
              <span class="surcharge-unit">{t.home.sectionSurchargesPercentOf}</span>
            </p>
            <p class="surcharge-note">{missingRef.note[lang]}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== PART II: EXTRA OUTFITS ===== */}
  <section class="section section-alt" id="outfits">
    <div class="section-inner">
      <div class="section-head">
        <span class="section-tag">{t.home.sectionOutfitsTag}</span>
        <h2 class="section-title">{t.home.sectionOutfitsTitle}</h2>
      </div>
      <OutfitTable locale={lang} />
    </div>
  </section>

  {/* ===== PART III: ANIMATIONS ===== */}
  <section class="section" id="animations">
    <div class="section-inner">
      <div class="section-head">
        <span class="section-tag">{t.home.sectionAnimationsTag}</span>
        <h2 class="section-title">{t.home.sectionAnimationsTitle}</h2>
      </div>

      {/* Grid 4 card: idle, sit, walk, run — reuse style surcharge-* để đồng bộ */}
      <div class="surcharges-grid">
        {packages.animations.items.map((a) => (
          <div class="surcharge-card">
            <p class="surcharge-label">{a.label[lang]}</p>
            <p class="surcharge-price">
              {formatPrice(a.price, lang)}
              {a.note && <span class="surcharge-unit">· {a.note[lang]}</span>}
            </p>
          </div>
        ))}
      </div>

      {/* Điều kiện — reuse style conditions giống OutfitTable (list bullet) */}
      <div class="anim-conditions">
        <h3 class="anim-conditions-title">{t.home.sectionAnimationsConditionsTitle}</h3>
        <ul class="anim-conditions-list">
          {packages.animations.conditions[lang].map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ===== CTA BOOK ===== */}
  <section class="cta-section">
    <div class="cta-inner">
      <h2 class="cta-title">{t.home.ctaBookTitle}</h2>
      <p class="cta-body">{t.home.ctaBookBody}</p>
      <div class="cta-actions">
        <BookButton locale={lang} size="lg" variant="primary" />
        <a class="link-ghost" href={`/${lang}/tos`}>{t.home.ctaReadTos}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== HERO ===== */
  .hero {
    padding: 60px 20px 40px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 1200px;
    height: 1200px;
    max-width: 150vw;
    background: radial-gradient(
      circle at center,
      color-mix(in oklab, var(--color-accent) 10%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.02em;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(28px, 6vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--color-text);
    max-width: 20ch;
  }
  .hero-subtitle {
    margin: 0;
    font-size: clamp(15px, 2.5vw, 17px);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 55ch;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
  }

  /* ===== SECTIONS ===== */
  .section {
    padding: 60px 20px;
  }
  .section-alt {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 60ch;
  }
  .section-tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
  }
  .section-title {
    margin: 0;
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }
  .section-intro {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* ===== PACKAGES GRID ===== */
  .pkg-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .pkg-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .pkg-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ===== WHY ===== */
  .why-card {
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }
  .why-title {
    margin: 0 0 8px 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
  }
  .why-body {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 70ch;
  }

  /* ===== SURCHARGES ===== */
  .surcharges-title {
    margin: 0 0 12px 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    color: var(--color-text-subtle);
  }
  .surcharges-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .surcharges-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .surcharge-card {
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  .surcharge-label {
    margin: 0 0 8px 0;
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .surcharge-price {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: var(--color-warning);
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-variant-numeric: tabular-nums;
  }
  .surcharge-unit {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-text-subtle);
    text-transform: lowercase;
  }
  .surcharge-note {
    margin: 10px 0 0 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-text-subtle);
  }

  /* ===== PART III: ANIMATIONS CONDITIONS =====
     Style mô phỏng .outfit-conditions trong OutfitTable để nhìn đồng bộ. */
  .anim-conditions {
    margin-top: 24px;
    padding: 20px;
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    border: 1px dashed var(--color-border-strong);
  }
  .anim-conditions-title {
    margin: 0 0 10px 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .anim-conditions-list {
    list-style: disc;
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .anim-conditions-list li {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .anim-conditions-list li::marker {
    color: var(--color-text-subtle);
  }

  /* ===== CTA ===== */
  .cta-section {
    padding: 80px 20px;
  }
  .cta-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 40px 32px;
    border-radius: var(--radius-xl);
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-accent) 10%, var(--color-surface)) 0%,
      var(--color-surface) 100%
    );
    border: 1px solid var(--color-border);
  }
  .cta-title {
    margin: 0;
    font-size: clamp(22px, 3.5vw, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .cta-body {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  /* Shared */
  .link-ghost {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: color 0.15s;
  }
  .link-ghost:hover {
    color: var(--color-accent);
  }
</style>
