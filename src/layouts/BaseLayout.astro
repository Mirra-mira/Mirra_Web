---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WeatherFX from "../components/WeatherFX.astro";
import { getUI, type Locale } from "../i18n";

export interface Props {
  locale: Locale;
  currentPath: string; // "/", "/tos", "/about"
  title?: string;
  description?: string;
}

const { locale, currentPath, title, description } = Astro.props;
const t = getUI(locale);
const pageTitle = title ? `${title} · Mirra` : t.siteTitle;
const pageDesc = description ?? t.siteDescription;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={pageDesc} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Theme init — chạy inline sớm để tránh FOUC */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("mirra.theme");
          if (t === "dark" || t === "light") {
            document.documentElement.dataset.theme = t;
          } else {
            document.documentElement.dataset.theme = "light";
          }
        } catch (_e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>

    {/* Scroll restore khi đổi ngôn ngữ.
         LangSwitcher lưu {y, path, ts} vào sessionStorage trước khi navigate.
         Ở đây đọc lại và scroll về đúng vị trí nếu path khớp + mới (<10s). */}
    <script is:inline>
      (function () {
        try {
          // Tắt scroll restoration mặc định của browser để không bị conflict
          if ("scrollRestoration" in history) {
            history.scrollRestoration = "manual";
          }
          var raw = sessionStorage.getItem("mirra.langScroll");
          if (!raw) return;
          var data = JSON.parse(raw);
          sessionStorage.removeItem("mirra.langScroll");
          if (!data || Date.now() - data.ts > 10000) return;
          // Normalize path (bỏ trailing slash) để so khớp
          function norm(p) {
            return (p || "").replace(/\/$/, "") || "/";
          }
          if (norm(data.path) !== norm(location.pathname)) return;
          var y = Number(data.y) || 0;
          function doScroll() {
            window.scrollTo(0, y);
          }
          // Scroll ngay khi DOM parse xong (layout đã cơ bản)
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", doScroll);
          } else {
            doScroll();
          }
          // Scroll thêm lần nữa sau khi ảnh/font load — phòng height đổi muộn
          window.addEventListener("load", doScroll);
        } catch (_e) {}
      })();
    </script>
  </head>
  <body>
    {/* Lớp hiệu ứng thời tiết toàn trang: fixed, phủ viewport, ở z-index: -1
         → nằm sau Header/main/Footer nhưng trên nền <html>. */}
    <WeatherFX variant="body" />
    <Header locale={locale} currentPath={currentPath} />
    <main class="page-main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .page-main {
    min-height: calc(100dvh - 56px);
  }
</style>
